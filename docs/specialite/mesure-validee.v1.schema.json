{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.queenbee.example/mesure-validee/v1.json",
  "title": "MesureValidée.v1",
  "description": "Published language du contexte Collecte IoT (QueenBee). Auteurs : Calixte Nguemo, Jule Rosier (M1 Data).",
  "type": "object",
  "required": ["eventId", "type", "version", "occurredAt", "receivedAt", "validatedAt", "producer", "gatewayId", "deliveryMode", "samplingMode", "dedupKey", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "MesureValidée" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "validatedAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "collecte-iot" },
    "gatewayId": { "type": "string", "pattern": "^GW-[A-Z]{3,4}-\\d{2}$" },
    "deliveryMode": { "enum": ["TEMPS_REEL", "DIFFERE"] },
    "samplingMode": { "enum": ["NORMAL", "RENFORCE", "SEUIL"] },
    "dedupKey": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z]{3,4}-\\d{3}\\|.+Z$" },
    "schemaUri": { "type": "string", "format": "uri" },
    "payload": {
      "type": "object",
      "required": ["hive_id", "site_id", "sensor_id", "timestamp", "frame_counter", "weight_kg", "temp_internal_c", "temp_external_c", "humidity_pct", "acoustic_activity_score", "quality"],
      "properties": {
        "hive_id": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z]{3,4}-\\d{3}$" },
        "site_id": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z]{3,4}$" },
        "sensor_id": { "type": "string", "minLength": 1 },
        "sensor_firmware": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "frame_counter": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "weight_kg": { "type": "number", "minimum": 0, "maximum": 150 },
        "temp_internal_c": { "type": "number", "minimum": -10, "maximum": 60 },
        "temp_external_c": { "type": "number", "minimum": -20, "maximum": 60 },
        "humidity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "acoustic_activity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "battery_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "position_lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "position_lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "quality": {
          "type": "object",
          "required": ["flags"],
          "properties": {
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["VARIATION_BRUTALE", "SONDE_SUSPECTE", "BATTERIE_FAIBLE", "DIFFERE", "GPS_ABSENT"] }
            }
          }
        }
      },
      "dependentRequired": { "position_lat": ["position_lon"], "position_lon": ["position_lat"] }
    }
  }
}
